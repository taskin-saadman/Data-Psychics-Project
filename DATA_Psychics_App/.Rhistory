counts = c(41, 52, 46, 61, 58, 72, 75, 63, 80, 65)
c_mat = matrix(counts, nrow = 2, byrow = TRUE)
colnames(c_mat) = c("Open", "Conscientious", "Extrovert", "Agreeable", "Neurotic")
rownames(c_mat) = c("Business", "Social Science")
barplot(
c_mat,
beside = TRUE,
col = c("steelblue", "tomato"),
legend.text = TRUE,
xlab = "Personality Type",
ylab = "Number of Students",
main = "Personality Types by Major",
ylim = c(0, 100)
)
barplot(
c_mat,
beside = F,
col = c("steelblue", "tomato"),
legend.text = TRUE,
xlab = "Personality Type",
ylab = "Number of Students",
main = "Personality Types by Major",
ylim = c(0, 100)
)
barplot(
c_mat,
beside = T,
col = c("steelblue", "tomato"),
legend.text = TRUE,
xlab = "Personality Type",
ylab = "Number of Students",
main = "Personality Types by Major",
ylim = c(0, 100)
)
# Convert counts to proportions within each major
prop_mat = prop.table(c_mat, margin = 1)
barplot(
t(prop_mat),
beside = TRUE,
col = c("steelblue", "tomato"),
legend.text = TRUE,
xlab = "Major",
ylab = "Proportion",
main = "Personality Type Distribution by Major",
ylim = c(0, 0.35)
)
barplot(
t(prop_mat),
beside = TRUE,
col = c("steelblue", "tomato", "green", "magenta"),
legend.text = TRUE,
xlab = "Major",
ylab = "Proportion",
main = "Personality Type Distribution by Major",
ylim = c(0, 0.35)
)
# Convert counts to proportions within each major
prop_mat = prop.table(c_mat, margin = 1)
barplot(
t(prop_mat),
beside = TRUE,
col = c("steelblue", "tomato", "maroon", "magenta"),
legend.text = TRUE,
xlab = "Major",
ylab = "Proportion",
main = "Personality Type Distribution by Major",
ylim = c(0, 0.35)
)
