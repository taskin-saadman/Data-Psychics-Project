counts = c(41, 52, 46, 61, 58, 72, 75, 63, 80, 65)
c_mat = matrix(counts, nrow = 2, byrow = TRUE)
colnames(c_mat) = c("Open", "Conscientious", "Extrovert", "Agreeable", "Neurotic")
rownames(c_mat) = c("Business", "Social Science")
#Convert counts to proportions within each major
prop_mat = prop.table(c_mat, margin = 1)
barplot(
prop_mat,
beside = TRUE,
col = c("steelblue", "tomato", "purple", "magenta", "brown"),
legend.text = TRUE,
xlab = "Major",
ylab = "Proportion",
main = "Personality Type Distribution by Major",
ylim = c(0, 0.4)
)
#plot shows that the proportions are fairly similar, although
#there are some differences (all ~20%)
#appropriate: chi-squared test for homogenity
#H0: The distribution of personality types is the same for both majors.
#H1: The distribution of personality types differs between the two majors.
#At the 5% significance level:
#Reject H0 if the p-value < 0.05.
#Otherwise, fail to reject H0.
chisq.test(c_mat)
