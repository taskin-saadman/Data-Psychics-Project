t(prop_mat),
beside = TRUE,
col = c("steelblue", "tomato", "maroon", "magenta", "brown"),
legend.text = TRUE,
xlab = "Major",
ylab = "Proportion",
main = "Personality Type Distribution by Major",
ylim = c(0, 0.35)
)
barplot(
t(prop_mat),
beside = TRUE,
col = c("steelblue", "tomato", "purple", "magenta", "brown"),
legend.text = TRUE,
xlab = "Major",
ylab = "Proportion",
main = "Personality Type Distribution by Major",
ylim = c(0, 0.35)
)
