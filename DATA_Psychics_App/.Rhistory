g <- function(r){
n * log(r/x_bar) - n * digamma(r) + sum(log(x))
}
gprime <- function(r){
n / r - n * trigamma(r)
}
r = r.mm #starting value
for (i in 1:20){
r = r - g(r)/gprime(r)
}
