binom_Y = 2*X + N
set.seed(100)
binom_X = rbinom(10^4, size = 5, prob = 0.4)
binom_N = rbinom(10^4, size = 8, prob = 0.2)
binom_Y = 2*binom_X + binom_N
binom_df = data.frame(X = binom_X, N = binom_N, Y = binom_Y)
View(binom_df)
par(mfrow = c(2, 3))
# For each possible value of X
for (x_val in 0:5) {
# Subset the data where X equals x_val
subset_Y <- df$Y[df$X == x_val]
# Calculate the theoretical PMF for Y given X = x_val
# This is the PMF of N + 2*x_val, where N ~ Binomial(8, 0.2)
y_vals <- 2*x_val + 0:8  # Possible Y values given X = x_val
pmf_vals <- dbinom(0:8, size = 8, prob = 0.2)  # PMF of N
# Expected value of Y given X = x_val
# E[Y|X=x_val] = E[2*x_val + N|X=x_val] = 2*x_val + E[N] = 2*x_val + 8*0.2
expected_Y <- 2*x_val + 8*0.2
# Calculate histogram for y-limit calculation
hist_obj <- hist(subset_Y, plot = FALSE,
breaks = seq(min(y_vals)-0.5, max(y_vals)+0.5, by = 1))
# Find maximum of both empirical and theoretical probabilities
y_max <- max(c(pmf_vals, hist_obj$density)) * 1.2
# Plot the histogram with breaks at 0.5 below and 0.5 above each integer
hist(subset_Y, probability = TRUE,
breaks = seq(min(y_vals)-0.5, max(y_vals)+0.5, by = 1),
main = paste("Y given X =", x_val),
xlab = "Y", ylab = "Probability",
xlim = c(min(y_vals)-0.5, max(y_vals)+0.5),
ylim = c(0, y_max))
# Overlay the exact PMF (red lines and points)
points(y_vals, pmf_vals, type = "p", pch = 19, col = "red")
segments(y_vals, 0, y_vals, pmf_vals, col = "red", lwd = 2)
# Add vertical line at expected value (blue line)
abline(v = expected_Y, lwd = 2, col = "blue")
# Add legend
legend("topright", legend = c("Empirical Histogram", "Exact PMF", "Expected Value"),
col = c("black", "red", "blue"), lwd = c(1, 2, 2), pch = c(NA, 19, NA))
}
