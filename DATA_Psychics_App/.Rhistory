lam.mm = (x_bar)/(s_2 - x_bar^2)
r.mm
lam.mm
g <- function(r){
n * log(r/x_bar) -
n * digamma(r) +
sum(log(x))
}
gprime <- function(r){
(n/r) - n * trigamma(r)
}
#Newton-Raphson method
r_iteration = r.mm #starting value
for (i in 1:20){
r_iteration = r_iteration -
g(r_iteration)/gprime(r_iteration)
}
#maximum likelihood estimates
r.mle <- r_iteration
lam.mle <- r.mle / x_bar #based on formula earlier
r.mle
lam.mle
