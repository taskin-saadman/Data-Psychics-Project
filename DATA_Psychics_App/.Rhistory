library(tidyverse)
sample_data <- rpois(n=50000, lambda=2)
freq_table <- tibble(value = sample_data) |>
count(value, name = "Freq")
freq_table |>
ggplot(aes(value, Freq)) +
geom_col() +
theme_minimal()
